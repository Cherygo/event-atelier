APP_NAME="Event Atelier"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=event_atelier
DB_USERNAME=event_atelier
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Configure a real mail transport before inviting users or sending password resets.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
